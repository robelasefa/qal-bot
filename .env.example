TELEGRAM_BOT_TOKEN=
TELEGRAM_DEV_BOT_TOKEN=

ADDIS_API_KEY=

DEBUG=true  # true = long polling, false = webhook

# Webhook settings (required when DEBUG=false)
# For local testing, you can use ngrok http 8080, then set WEBHOOK_URL to the https url + /telegram
WEBHOOK_URL=  # public https:// url
WEBHOOK_SECRET=  # e.g. python -c "import secrets; print('whsec_' + secrets.token_urlsafe(32))"
WEBHOOK_LISTEN=127.0.0.1  # use 0.0.0.0 only when the bot itself is public
WEBHOOK_PORT=8080

# Optional: where language choices and the daily budget are stored.
# On Azure App Service this defaults to /home/data (persistent).
# DATA_DIR=/home/data

# Optional settings
OWNER_USER_ID=  # owner-only commands; leave empty to disable
ALLOWED_USER_IDS=  # owner is always allowed, leave empty to allow everyone
MAX_AUDIO_SECONDS=600  # in seconds
RATE_LIMIT_PER_HOUR=5
DAILY_TRANSCRIPTION_LIMIT=100
TRANSCRIBE_CONCURRENCY=2
